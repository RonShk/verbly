rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Student-owned learning data (userId on doc = Firebase Auth uid).
    match /vocab_cards/{cardId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /vocab_lists/{listId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /user_todo_assignments/{assignmentId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /user_completed_assignments/{assignmentId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Question sets and legacy paths: student app uses Cloud Functions (Admin SDK) only.
    match /production_question_sets/{document=**} {
      allow read, write: if false;
    }
    match /translation_question_sets/{document=**} {
      allow read, write: if false;
    }
    match /vocab_question_sets/{document=**} {
      allow read, write: if false;
    }

    // Tutor schema (Step 4+): deny direct client access; teacher site uses Admin SDK.
    match /teachers/{document=**} {
      allow read, write: if false;
    }
    match /students/{studentUid} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == studentUid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

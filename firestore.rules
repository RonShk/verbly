rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function assignmentOwner(assignmentId) {
      return isOwner(get(/databases/$(database)/documents/user_assignments/$(assignmentId)).data.userId);
    }

    // Per-student vocab deck: parent holds summary; cards subcollection holds FSRS state.
    // All writes go through Cloud Functions (Admin SDK). Clients read only.
    match /student_vocab/{studentUid} {
      allow read: if isOwner(studentUid);
      allow write: if false;

      match /cards/{cardId} {
        allow read: if isOwner(studentUid);
        allow write: if false;
      }
    }

    // Unified sentence-practice assignments (issue #58): one doc per assignment
    // with a `questions` subcollection. The student app subscribes directly to
    // its own assignment doc + questions to stream progress and questions as
    // they are generated. All writes are Admin-SDK only (Cloud Functions:
    // session lookup/creation, generation pipeline, grading).
    match /user_assignments/{assignmentId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;

      // List queries use orderBy('index') only (no userId filter). Authorize via
      // the parent assignment so Firestore can prove the query is safe.
      match /questions/{questionId} {
        allow read: if assignmentOwner(assignmentId);
        allow write: if false;
      }
    }

    // Tutor schema (Step 4+): deny direct client access; teacher site uses Admin SDK.
    match /teachers/{document=**} {
      allow read, write: if false;
    }
    match /students/{studentUid} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == studentUid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
